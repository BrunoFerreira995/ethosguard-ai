FROM python:3.12-slim
COPY --from=ghcr.io/astral-sh/uv:0.12.1 /uv /usr/local/bin/uv

WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_NO_CACHE=1 \
    HF_HOME=/tmp/huggingface \
    ETHICS_CONFIG_PATH=/app/config/ethics.json \
    PATH="/app/.venv/bin:$PATH"

COPY services/gliner/pyproject.toml services/gliner/uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

COPY services/gliner/app ./app
COPY config/ethics.json ./config/ethics.json

EXPOSE 80
CMD ["sh", "-c", "exec uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-80}"]
